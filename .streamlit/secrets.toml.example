# Copy to .streamlit/secrets.toml (gitignored) for local use, and paste the same
# line into Streamlit Cloud → App settings → Secrets.
#
# Fine-grained GitHub token, scoped to ONLY this repo,
# permission "Contents: Read and write", with an expiry date set.
# Used to read/write the candidate's data on the `user-data` branch and to download the
# jobs database from the `jobs-data` branch.
#
# Named MSCM_GITHUB_TOKEN on purpose — not GITHUB_TOKEN, which gh/CI tools set.

MSCM_GITHUB_TOKEN = "github_pat_..."
